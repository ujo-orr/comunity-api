# 복사 후 직접 채운다. 실제 값은 Git에 커밋하지 않는다.
# Spring Boot는 .env를 자동으로 읽지 않으므로 실행 전에 export/source가 필요하다.
SPRING_PROFILES_ACTIVE=local
JWT_SECRET=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
FILE_UPLOAD_DIR=./uploads

# docker profile: Compose MySQL root 비밀번호와 DB_PASSWORD를 동일하게 설정한다.
MYSQL_ROOT_PASSWORD=
DB_URL='jdbc:mysql://localhost:3306/community?serverTimezone=Asia/Seoul&characterEncoding=UTF-8'
DB_USERNAME=root
DB_PASSWORD=

# prod: profile을 prod로 바꾸고 DB_*를 RDS 값으로 교체한다.
# DB_URL='jdbc:mysql://RDS_ENDPOINT:3306/community?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&sslMode=VERIFY_IDENTITY'
# RDS CA를 JVM truststore에 먼저 등록해야 한다. docs/aws-deployment.md 참고.
AWS_REGION=ap-northeast-2
S3_BUCKET=
AWS_EC2_METADATA_V1_DISABLED=true
