# Spring Boot 실행 전 환경변수 로드 필요: set -a; source .env; set +a
# 특수문자($, &, ! 등)가 있는 값은 작은따옴표로 감싸기
# 로컬 IntelliJ는 기존 환경변수와 local 프로필 사용. 운영용 .env 사용 제외

# Spring Boot
SPRING_PROFILES_ACTIVE=prod

# JWT
JWT_SECRET=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis는 서버 내부 접속만 허용하고 비밀번호 미사용. 아래 값은 빈칸 유지
REDIS_PASSWORD=

# MySQL
# MYSQL_ROOT_PASSWORD와 DB_PASSWORD는 같은 값으로 설정
MYSQL_ROOT_PASSWORD=
DB_URL='jdbc:mysql://localhost:3306/community?serverTimezone=Asia/Seoul&characterEncoding=UTF-8'
DB_USERNAME=root
DB_PASSWORD=

# AWS S3 인증은 EC2 IAM Role 사용. Access Key/Secret Key 입력 불필요
AWS_REGION=ap-northeast-2
S3_BUCKET=

# EC2에서 AWS SDK의 IMDSv1 사용 차단
AWS_EC2_METADATA_V1_DISABLED=true

# 관리자 계정 생성 설정은 기본 false. 일반 재시작 시 변경 불필요
# 최초 관리자 계정 생성 시에만 활성화하고 별도 비밀번호(12자 이상) 입력
# 생성 후 false로 변경하고 관리자 생성용 비밀번호 환경변수 삭제
# BOOTSTRAP_ADMIN_ENABLED=false
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_SUPERADMIN_ENABLED=false
# BOOTSTRAP_SUPERADMIN_PASSWORD=
