# EC2 운영용: .env로 복사하고 실제 값은 서버에서만 입력한다. Git 커밋 금지.
# Spring Boot는 .env를 자동으로 읽지 않는다. 실행 전에 set -a; source .env; set +a 사용.
# 특수문자(예: $, &, !)가 있는 값은 작은따옴표로 감싼다.
# 로컬 IntelliJ는 기존 환경변수와 local profile을 유지하고 이 운영 파일을 로드하지 않는다.

# Spring Boot
SPRING_PROFILES_ACTIVE=prod

# JWT
JWT_SECRET=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# 제공된 Redis는 loopback 전용이며 인증 미설정이므로 비워둔다.
REDIS_PASSWORD=

# MySQL
# Docker Compose의 MYSQL_ROOT_PASSWORD와 DB_PASSWORD는 동일하게 설정.
MYSQL_ROOT_PASSWORD=
DB_URL='jdbc:mysql://localhost:3306/community?serverTimezone=Asia/Seoul&characterEncoding=UTF-8'
DB_USERNAME=root
DB_PASSWORD=

# AWS S3: Access Key/Secret Key를 추가하지 않는다. EC2 IAM Role 사용.
AWS_REGION=ap-northeast-2
S3_BUCKET=

# EC2에서 AWS SDK가 IMDSv1을 사용하지 않도록 설정.
AWS_EC2_METADATA_V1_DISABLED=true

# 기존 관리자 초기화는 기본 false. 일반적인 재기동에는 필요하지 않다.
# 최초 관리자 계정 생성이 필요한 경우에만 활성화하고 별도 비밀번호(12자 이상)를 입력한다.
# 생성 후 다시 false로 바꾸고 bootstrap 비밀번호는 환경에서 제거한다.
# BOOTSTRAP_ADMIN_ENABLED=false
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_SUPERADMIN_ENABLED=false
# BOOTSTRAP_SUPERADMIN_PASSWORD=
